{
  "name": "logbeam",
  "version": "0.9.0",
  "private": true,
  "description": "Chrome extension for developers & platform engineers: readable logs, dark mode everywhere, and one-click JSON / JWT / Base64 / timestamp / cron tools.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs && node scripts/build.mjs --firefox",
    "watch": "node scripts/build.mjs --watch",
    "icons": "node scripts/icons.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check": "npm run lint && npm run format:check && npm run typecheck && npm test && npm run build",
    "package": "npm run build && node scripts/package.mjs",
    "screenshots": "npm run e2e",
    "store-assets": "node scripts/store-assets.mjs",
    "demo-gif": "npm run build && node scripts/demo-gif.mjs",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "e2e": "npm run build && node scripts/e2e.mjs",
    "watch:firefox": "node scripts/build.mjs --watch --firefox",
    "lint:firefox": "web-ext lint --source-dir dist-firefox",
    "e2e:firefox": "node scripts/e2e-firefox.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/chrome": "^0.3.5",
    "@types/node": "^26.6.5",
    "esbuild": "^0.28.2",
    "eslint": "^10.13.0",
    "gifenc": "^1.0.3",
    "globals": "^17.13.0",
    "playwright": "^1.64.1",
    "pngjs": "^7.0.0",
    "prettier": "^3.9.10",
    "selenium-webdriver": "^4.51.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.5",
    "web-ext": "^10.8.0"
  }
}
