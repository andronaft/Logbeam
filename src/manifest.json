{
  "manifest_version": 3,
  "name": "Logbeam",
  "short_name": "Logbeam",
  "version": "0.5.0",
  "description": "__MSG_extDescription__",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Logbeam",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png"
    }
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": ["storage", "contextMenus", "activeTab", "scripting"],
  "optional_host_permissions": ["<all_urls>"],
  "commands": {
    "open-log-viewer": {
      "suggested_key": {
        "default": "Ctrl+Shift+L",
        "mac": "MacCtrl+Shift+L"
      },
      "description": "__MSG_cmdOpenLogViewer__"
    },
    "toggle-dark-mode": {
      "suggested_key": {
        "default": "Ctrl+Shift+K",
        "mac": "MacCtrl+Shift+K"
      },
      "description": "__MSG_cmdToggleDarkMode__"
    }
  },
  "minimum_chrome_version": "110",
  "default_locale": "en"
}
