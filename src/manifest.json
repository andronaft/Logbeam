{
  "manifest_version": 3,
  "name": "Logbeam",
  "short_name": "Logbeam",
  "version": "0.4.0",
  "description": "Readable logs, dark mode for any site, and one-click JSON / JWT / Base64 / timestamp / cron tools. 100% local.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Logbeam",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png"
    }
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": ["storage", "contextMenus", "activeTab", "scripting"],
  "optional_host_permissions": ["<all_urls>"],
  "commands": {
    "open-log-viewer": {
      "suggested_key": {
        "default": "Ctrl+Shift+L",
        "mac": "MacCtrl+Shift+L"
      },
      "description": "Open the current page in the log viewer"
    },
    "toggle-dark-mode": {
      "suggested_key": {
        "default": "Ctrl+Shift+K",
        "mac": "MacCtrl+Shift+K"
      },
      "description": "Toggle dark mode for the current tab"
    }
  },
  "minimum_chrome_version": "110"
}
